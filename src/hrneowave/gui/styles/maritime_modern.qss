/* CHNeoWave — canonical laboratory interface
   One palette, one density scale, one component hierarchy. */

QMainWindow,
QDialog {
    background-color: #F3F6F8;
    color: #172B35;
}

QWidget {
    color: #172B35;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 12px;
}

QWidget#workspace,
QWidget#mainContent,
QWidget#contentCanvas,
QScrollArea#pageScroll,
QScrollArea#pageScroll > QWidget > QWidget {
    background-color: #F3F6F8;
}

/* Application shell */
QFrame#main_sidebar {
    background-color: #0B1F2A;
    border: none;
    border-right: 1px solid #183846;
}

QFrame#sidebar_header {
    background-color: #0B1F2A;
    border: none;
    border-bottom: 1px solid #183846;
}

QLabel#brandMark {
    background-color: #1A7188;
    color: #FFFFFF;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 700;
}

QLabel#brandName {
    color: #F4F8FA;
    font-size: 16px;
    font-weight: 700;
}

QLabel#brandDescriptor,
QLabel#navSection,
QLabel#sidebarVersion {
    color: #8EA6B2;
    font-size: 10px;
    font-weight: 600;
}

QPushButton#navButton {
    background-color: transparent;
    color: #B9C9D1;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    min-height: 40px;
    padding: 0 14px;
    text-align: left;
    font-weight: 500;
}

QPushButton#navButton:hover {
    background-color: #112C39;
    color: #FFFFFF;
}

QPushButton#navButton[active="true"] {
    background-color: #153846;
    color: #FFFFFF;
    border-left: 3px solid #42B8C6;
    font-weight: 600;
}

QPushButton#navButton[collapsed="true"] {
    padding: 0;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
}

QFrame#sidebar_footer {
    background-color: #091A23;
    border: none;
    border-top: 1px solid #183846;
}

QFrame#sidebarStatusDot {
    background-color: #C47B18;
    border: none;
    border-radius: 4px;
}
QFrame#sidebarStatusDot[connected="true"] { background-color: #53C6A0; }
QLabel#sidebarStatus { color: #B9C9D1; font-size: 11px; }

QFrame#applicationHeader {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #DCE5EA;
}

QPushButton#sidebarToggleButton,
QPushButton#themeToggleButton {
    background-color: #F3F7F8;
    color: #304A56;
    border: 1px solid #D3DEE3;
    border-radius: 6px;
    padding: 0;
    font-size: 16px;
}

QPushButton#sidebarToggleButton:hover,
QPushButton#themeToggleButton:hover {
    background-color: #E4EFF2;
    color: #145E72;
    border-color: #88ADB9;
}

QLabel#pageEyebrow {
    color: #1A7188;
    font-size: 10px;
    font-weight: 700;
}

QLabel#pageTitle {
    color: #172B35;
    font-size: 17px;
    font-weight: 650;
}

QLabel#pageSubtitle,
QLabel#mutedText,
QLabel[role="muted"] {
    color: #667C88;
}

QLabel#offlineBadge,
QLabel#hardwareBadge,
QLabel[state="neutral"] {
    background-color: #EDF3F5;
    color: #4E6673;
    border: 1px solid #DCE5EA;
    border-radius: 3px;
    padding: 4px 9px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#hardwareBadge[connected="true"] {
    background-color: #E6F4EF;
    color: #126A56;
    border-color: #BFE4D7;
}

QLabel[state="success"] {
    background-color: #E6F4EF;
    color: #126A56;
    border: 1px solid #BFE4D7;
    border-radius: 3px;
    padding: 4px 9px;
    font-size: 10px;
    font-weight: 700;
}

QLabel[state="warning"] {
    background-color: #FFF3DE;
    color: #8B570F;
    border: 1px solid #F0D19C;
    border-radius: 3px;
    padding: 4px 9px;
    font-size: 10px;
    font-weight: 700;
}

QLabel[state="danger"] {
    background-color: #FCEBEC;
    color: #99383F;
    border: 1px solid #EFC8CB;
    border-radius: 3px;
    padding: 4px 9px;
    font-size: 10px;
    font-weight: 700;
}

/* Typography and structured surfaces */
QLabel#viewTitle {
    color: #172B35;
    font-size: 20px;
    font-weight: 650;
}

QLabel#sectionTitle {
    color: #203843;
    font-size: 14px;
    font-weight: 650;
}

QLabel#metricLabel {
    color: #667C88;
    font-size: 11px;
    font-weight: 600;
}

QLabel#metricValue {
    color: #172B35;
    font-size: 16px;
    font-weight: 650;
}

QFrame#surface,
QFrame#projectForm,
QFrame#contextPanel,
QFrame#metricCard,
QFrame#workflowCard,
QFrame#analysis_tools_panel,
QFrame#analysis_results_area,
QFrame#surface,
QFrame#report_config_panel,
QFrame#report_preview_area,
QFrame#operationalHeader {
    background-color: #FFFFFF;
    border: 1px solid #DCE5EA;
    border-radius: 4px;
}

QFrame#contextBar {
    background-color: #F8FAFB;
    border: 1px solid #E2EAEE;
    border-radius: 6px;
}

QFrame#flatPanel {
    background-color: transparent;
    border: none;
    border-top: 1px solid #E5ECEF;
}

QWidget#calibrationWorkspace {
    background-color: #F3F6F8;
}

QFrame#metricCard {
    border-top: 3px solid #2B8298;
}

QFrame#workflowCard[active="true"] {
    border-left: 3px solid #1A7188;
}

QFrame#quietSurface {
    background-color: #F8FAFB;
    border: 1px solid #E5ECEF;
    border-radius: 3px;
}

QFrame#divider {
    background-color: #DCE5EA;
    border: none;
    max-height: 1px;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QDateEdit,
QDoubleSpinBox,
QSpinBox,
QComboBox {
    background-color: #FFFFFF;
    color: #172B35;
    border: 1px solid #C9D6DC;
    border-radius: 3px;
    padding: 5px 8px;
    min-height: 20px;
    selection-background-color: #1A7188;
    selection-color: #FFFFFF;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QDateEdit:focus,
QDoubleSpinBox:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 2px solid #1A7188;
    padding: 4px 7px;
}

QLineEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #EEF2F4;
    color: #8699A3;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #172B35;
    border: 1px solid #C9D6DC;
    selection-background-color: #DCEEF2;
    selection-color: #172B35;
}

QCheckBox { spacing: 8px; color: #405965; }
QCheckBox::indicator { width: 15px; height: 15px; }

/* Buttons: one visual priority per view */
QPushButton {
    background-color: #FFFFFF;
    color: #38515D;
    border: 1px solid #C9D6DC;
    border-radius: 3px;
    padding: 6px 11px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #F3F7F8;
    color: #145E72;
    border-color: #88ADB9;
}
QPushButton:pressed { background-color: #E4EFF2; }
QPushButton:disabled {
    background-color: #E3E9EC;
    color: #8798A1;
    border-color: #D7E0E4;
}

QPushButton[kind="secondary"],
QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #38515D;
    border: 1px solid #C9D6DC;
}

QPushButton[kind="secondary"]:hover,
QPushButton#secondaryButton:hover {
    background-color: #F3F7F8;
    color: #145E72;
    border-color: #88ADB9;
}

QPushButton[kind="quiet"] {
    background-color: transparent;
    color: #4E6673;
    border-color: transparent;
}

QPushButton[kind="icon"] {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    background-color: transparent;
    border-color: transparent;
}

QPushButton[kind="icon"]:checked {
    background-color: #DCEEF2;
    border-color: #88ADB9;
}

QToolTip {
    background-color: #0B1F2A;
    color: #F4F8FA;
    border: 1px solid #315563;
    padding: 5px 7px;
}

QPushButton[kind="danger"] {
    background-color: #FFFFFF;
    color: #A23F45;
    border-color: #DCA9AD;
}

QPushButton[kind="primary"],
QPushButton[kind="primaryLarge"] {
    background-color: #1A7188;
    color: #FFFFFF;
    border-color: #1A7188;
}

QPushButton[kind="primary"]:hover,
QPushButton[kind="primaryLarge"]:hover {
    background-color: #145E72;
    color: #FFFFFF;
    border-color: #145E72;
}

QPushButton[kind="primary"]:pressed,
QPushButton[kind="primaryLarge"]:pressed {
    background-color: #0F4B5C;
}

QPushButton[kind="primaryLarge"] {
    min-height: 24px;
    padding: 7px 14px;
    font-size: 12px;
}

/* Tabs and groups */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #DCE5EA;
    border-radius: 4px;
    margin-top: 9px;
    padding: 10px 10px 8px 10px;
    font-weight: 650;
    color: #304A56;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    background-color: #FFFFFF;
}

QGroupBox#flatGroup {
    background-color: transparent;
    border: none;
    border-top: 1px solid #E5ECEF;
    border-radius: 0;
    margin-top: 9px;
    padding: 10px 0 0 0;
}

QGroupBox#flatGroup::title {
    left: 0;
    padding: 0 8px 0 0;
    background-color: #FFFFFF;
}

QGroupBox#sectionSurface {
    background-color: #F8FAFB;
    border: 1px solid #E2EAEE;
    border-radius: 6px;
    margin-top: 9px;
    padding: 10px 10px 8px 10px;
}

QGroupBox#sectionSurface::title {
    background-color: #F8FAFB;
}

QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #DCE5EA;
    border-radius: 3px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #667C88;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 14px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #145E72;
    border-bottom-color: #1A7188;
}

QTabBar::tab:hover:!selected { color: #304A56; background-color: #F3F7F8; }

/* Tables and lists */
QTableWidget,
QTableView,
QListWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F7F9FA;
    color: #203843;
    border: 1px solid #DCE5EA;
    border-radius: 3px;
    gridline-color: #E8EEF1;
    selection-background-color: #D9EBEF;
    selection-color: #172B35;
}

QTableWidget::item,
QTableView::item,
QListWidget::item { padding: 5px 7px; }

QListWidget::item { border-bottom: 1px solid #EEF2F4; }
QListWidget::item:selected { color: #145E72; font-weight: 600; }

QHeaderView::section {
    background-color: #EEF3F5;
    color: #405965;
    border: none;
    border-right: 1px solid #DCE5EA;
    border-bottom: 1px solid #D3DEE3;
    padding: 6px;
    font-size: 11px;
    font-weight: 650;
}

/* Feedback and utility */
QProgressBar {
    background-color: #E5ECEF;
    border: none;
    border-radius: 3px;
    height: 7px;
    text-align: center;
}

QProgressBar::chunk { background-color: #1A7188; border-radius: 3px; }

QProgressBar#qualificationProgress {
    border: 1px solid #D3DEE3;
    border-radius: 4px;
    min-height: 18px;
    max-height: 18px;
    color: #304A56;
    font-size: 10px;
}

/* Calibration instrument: the signal is the primary content. */
QFrame#calibrationCommandBar,
QFrame#calibrationSettingsPanel,
QFrame#calibrationResultStrip {
    background-color: #FFFFFF;
    border: 1px solid #CBD8DE;
    border-radius: 3px;
}

QFrame#calibrationSettingsPanel {
    background-color: #F6F9FA;
}

QLabel#technicalLabel {
    color: #56707C;
    font-size: 10px;
    font-weight: 700;
}

QLabel#sensorIdentity {
    color: #203A45;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-weight: 600;
}

QFrame#technicalSurface,
QFrame#instrumentPanel {
    background-color: #081820;
    border: 1px solid #234654;
    border-radius: 3px;
}

QTabWidget#calibrationPlotTabs::pane {
    background-color: #081820;
    border: none;
    border-top: 1px solid #234654;
    border-radius: 0;
}

QTabWidget#calibrationPlotTabs QTabBar::tab {
    background-color: #0C222C;
    color: #7F9AA5;
    border: none;
    border-right: 1px solid #234654;
    border-bottom: 2px solid transparent;
    padding: 7px 16px;
}

QTabWidget#calibrationPlotTabs QTabBar::tab:selected {
    background-color: #102B36;
    color: #EAF6F8;
    border-bottom-color: #45D4E7;
}

QFrame#instrumentPanel QLabel#technicalLabel {
    color: #76939E;
}

QLabel#instrumentRate {
    color: #8FAAB5;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}

QLabel#liveVoltage {
    color: #E8FBFD;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 30px;
    font-weight: 650;
    padding: 8px 2px 5px 2px;
}

QFrame#instrumentMetric {
    background-color: #0D242E;
    border: 1px solid #1E3E4A;
    border-radius: 2px;
}

QLabel#instrumentMetricValue {
    color: #D8E9EE;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    font-weight: 600;
}

QFrame#instrumentDivider {
    background-color: #274A57;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame#instrumentPanel QDoubleSpinBox,
QFrame#instrumentPanel QSpinBox,
QFrame#instrumentPanel QComboBox,
QFrame#instrumentPanel QLineEdit {
    background-color: #0D242E;
    color: #ECF7F9;
    border-color: #315563;
    selection-background-color: #137E92;
}

QFrame#instrumentPanel QTableWidget {
    background-color: #0A1D26;
    alternate-background-color: #0D242E;
    color: #D8E9EE;
    border-color: #315563;
    gridline-color: #1D3A46;
    selection-background-color: #174655;
    selection-color: #FFFFFF;
}

QFrame#instrumentPanel QHeaderView::section {
    background-color: #102B36;
    color: #8FAAB5;
    border-right-color: #274A57;
    border-bottom-color: #315563;
}

/* A disabled measurement command must never look executable.  These
   selectors deliberately follow the primary-button rules so that the
   physical interlock remains visible to the operator. */
QPushButton[kind="primary"]:disabled,
QPushButton[kind="primaryLarge"]:disabled {
    background-color: #E3E9EC;
    color: #8798A1;
    border-color: #D2DDE2;
}

QFrame#instrumentPanel QPushButton:disabled,
QFrame#instrumentPanel QPushButton[kind="primary"]:disabled {
    background-color: #132B34;
    color: #54717C;
    border-color: #24434F;
}

QFrame#calibrationMetric {
    background-color: transparent;
    border: none;
    border-left: 1px solid #DCE5EA;
    border-radius: 0;
}

QLabel#calibrationMetricValue {
    color: #17323D;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 13px;
    font-weight: 650;
}

QSplitter::handle { background-color: #DCE5EA; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QScrollArea { border: none; background-color: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #B7C6CD; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #8FA4AE; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #B7C6CD; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QTextEdit#reportDocument {
    background-color: #FFFFFF;
    border: 1px solid #D3DEE3;
    padding: 18px;
    font-family: "Segoe UI", sans-serif;
}

QToolTip {
    background-color: #172B35;
    color: #FFFFFF;
    border: 1px solid #304A56;
    padding: 6px 8px;
}
