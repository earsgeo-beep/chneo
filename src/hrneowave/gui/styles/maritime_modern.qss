/* CHNeoWave — canonical laboratory interface
   One palette, one density scale, one component hierarchy. */

QMainWindow,
QDialog {
    background-color: #F3F6F8;
    color: #172B35;
}

QWidget {
    color: #172B35;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QWidget#workspace,
QWidget#mainContent,
QWidget#contentCanvas,
QScrollArea#pageScroll,
QScrollArea#pageScroll > QWidget > QWidget {
    background-color: #F3F6F8;
}

/* Application shell */
QFrame#main_sidebar {
    background-color: #0B1F2A;
    border: none;
    border-right: 1px solid #183846;
}

QFrame#sidebar_header {
    background-color: #0B1F2A;
    border: none;
    border-bottom: 1px solid #183846;
}

QLabel#brandMark {
    background-color: #1A7188;
    color: #FFFFFF;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 700;
}

QLabel#brandName {
    color: #F4F8FA;
    font-size: 16px;
    font-weight: 700;
}

QLabel#brandDescriptor,
QLabel#navSection,
QLabel#sidebarVersion {
    color: #8EA6B2;
    font-size: 10px;
    font-weight: 600;
}

QPushButton#navButton {
    background-color: transparent;
    color: #B9C9D1;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    min-height: 44px;
    padding: 0 16px;
    text-align: left;
    font-weight: 500;
}

QPushButton#navButton:hover {
    background-color: #112C39;
    color: #FFFFFF;
}

QPushButton#navButton[active="true"] {
    background-color: #153846;
    color: #FFFFFF;
    border-left: 3px solid #42B8C6;
    font-weight: 600;
}

QPushButton#navButton[collapsed="true"] {
    padding: 0;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
}

QFrame#sidebar_footer {
    background-color: #091A23;
    border: none;
    border-top: 1px solid #183846;
}

QLabel#sidebarStatusDot { color: #C47B18; }
QLabel#sidebarStatusDot[connected="true"] { color: #53C6A0; }
QLabel#sidebarStatus { color: #B9C9D1; font-size: 11px; }

QFrame#applicationHeader {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #DCE5EA;
}

QPushButton#sidebarToggleButton {
    background-color: #F3F7F8;
    color: #304A56;
    border: 1px solid #D3DEE3;
    border-radius: 6px;
    padding: 0;
    font-size: 16px;
}

QPushButton#sidebarToggleButton:hover {
    background-color: #E4EFF2;
    color: #145E72;
    border-color: #88ADB9;
}

QLabel#pageEyebrow {
    color: #1A7188;
    font-size: 10px;
    font-weight: 700;
}

QLabel#pageTitle {
    color: #172B35;
    font-size: 20px;
    font-weight: 650;
}

QLabel#pageSubtitle,
QLabel#mutedText,
QLabel[role="muted"] {
    color: #667C88;
}

QLabel#offlineBadge,
QLabel[state="neutral"] {
    background-color: #EDF3F5;
    color: #4E6673;
    border: 1px solid #DCE5EA;
    border-radius: 10px;
    padding: 4px 9px;
    font-size: 10px;
    font-weight: 700;
}

QLabel[state="success"] {
    background-color: #E6F4EF;
    color: #126A56;
    border: 1px solid #BFE4D7;
    border-radius: 10px;
    padding: 4px 9px;
    font-size: 10px;
    font-weight: 700;
}

QLabel[state="warning"] {
    background-color: #FFF3DE;
    color: #8B570F;
    border: 1px solid #F0D19C;
    border-radius: 10px;
    padding: 4px 9px;
    font-size: 10px;
    font-weight: 700;
}

QLabel[state="danger"] {
    background-color: #FCEBEC;
    color: #99383F;
    border: 1px solid #EFC8CB;
    border-radius: 10px;
    padding: 4px 9px;
    font-size: 10px;
    font-weight: 700;
}

/* Typography and structured surfaces */
QLabel#viewTitle {
    color: #172B35;
    font-size: 24px;
    font-weight: 650;
}

QLabel#sectionTitle {
    color: #203843;
    font-size: 14px;
    font-weight: 650;
}

QLabel#metricLabel {
    color: #667C88;
    font-size: 11px;
    font-weight: 600;
}

QLabel#metricValue {
    color: #172B35;
    font-size: 21px;
    font-weight: 650;
}

QFrame#surface,
QFrame#projectForm,
QFrame#contextPanel,
QFrame#metricCard,
QFrame#workflowCard,
QFrame#analysis_tools_panel,
QFrame#analysis_results_area,
QFrame#surface,
QFrame#report_config_panel,
QFrame#report_preview_area,
QFrame#operationalHeader {
    background-color: #FFFFFF;
    border: 1px solid #DCE5EA;
    border-radius: 8px;
}

QWidget#calibrationWorkspace {
    background-color: #F3F6F8;
}

QFrame#metricCard {
    border-top: 3px solid #2B8298;
}

QFrame#workflowCard[active="true"] {
    border-left: 3px solid #1A7188;
}

QFrame#quietSurface {
    background-color: #F8FAFB;
    border: 1px solid #E5ECEF;
    border-radius: 6px;
}

QFrame#divider {
    background-color: #DCE5EA;
    border: none;
    max-height: 1px;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QDateEdit,
QDoubleSpinBox,
QSpinBox,
QComboBox {
    background-color: #FFFFFF;
    color: #172B35;
    border: 1px solid #C9D6DC;
    border-radius: 5px;
    padding: 7px 9px;
    min-height: 22px;
    selection-background-color: #1A7188;
    selection-color: #FFFFFF;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QDateEdit:focus,
QDoubleSpinBox:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 2px solid #1A7188;
    padding: 6px 8px;
}

QLineEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #EEF2F4;
    color: #8699A3;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #172B35;
    border: 1px solid #C9D6DC;
    selection-background-color: #DCEEF2;
    selection-color: #172B35;
}

QCheckBox { spacing: 8px; color: #405965; }
QCheckBox::indicator { width: 16px; height: 16px; }

/* Buttons: one visual priority per view */
QPushButton {
    background-color: #1A7188;
    color: #FFFFFF;
    border: 1px solid #1A7188;
    border-radius: 5px;
    padding: 8px 14px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton:hover { background-color: #145E72; border-color: #145E72; }
QPushButton:pressed { background-color: #0F4B5C; }
QPushButton:disabled {
    background-color: #E3E9EC;
    color: #8798A1;
    border-color: #D7E0E4;
}

QPushButton[kind="secondary"],
QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #38515D;
    border: 1px solid #C9D6DC;
}

QPushButton[kind="secondary"]:hover,
QPushButton#secondaryButton:hover {
    background-color: #F3F7F8;
    color: #145E72;
    border-color: #88ADB9;
}

QPushButton[kind="quiet"] {
    background-color: transparent;
    color: #4E6673;
    border-color: transparent;
}

QPushButton[kind="danger"] {
    background-color: #FFFFFF;
    color: #A23F45;
    border-color: #DCA9AD;
}

QPushButton[kind="primaryLarge"] {
    min-height: 30px;
    padding: 10px 18px;
    font-size: 13px;
}

/* Tabs and groups */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #DCE5EA;
    border-radius: 7px;
    margin-top: 12px;
    padding: 14px 12px 10px 12px;
    font-weight: 650;
    color: #304A56;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    background-color: #FFFFFF;
}

QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #DCE5EA;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #667C88;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 16px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #145E72;
    border-bottom-color: #1A7188;
}

QTabBar::tab:hover:!selected { color: #304A56; background-color: #F3F7F8; }

/* Tables and lists */
QTableWidget,
QTableView,
QListWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F7F9FA;
    color: #203843;
    border: 1px solid #DCE5EA;
    border-radius: 5px;
    gridline-color: #E8EEF1;
    selection-background-color: #D9EBEF;
    selection-color: #172B35;
}

QTableWidget::item,
QTableView::item,
QListWidget::item { padding: 7px 9px; }

QListWidget::item { border-bottom: 1px solid #EEF2F4; }
QListWidget::item:selected { color: #145E72; font-weight: 600; }

QHeaderView::section {
    background-color: #EEF3F5;
    color: #405965;
    border: none;
    border-right: 1px solid #DCE5EA;
    border-bottom: 1px solid #D3DEE3;
    padding: 8px;
    font-size: 11px;
    font-weight: 650;
}

/* Feedback and utility */
QProgressBar {
    background-color: #E5ECEF;
    border: none;
    border-radius: 3px;
    height: 7px;
    text-align: center;
}

QProgressBar::chunk { background-color: #1A7188; border-radius: 3px; }

QSplitter::handle { background-color: #DCE5EA; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QScrollArea { border: none; background-color: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #B7C6CD; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #8FA4AE; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #B7C6CD; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QTextEdit#reportDocument {
    background-color: #FFFFFF;
    border: 1px solid #D3DEE3;
    padding: 18px;
    font-family: "Segoe UI", sans-serif;
}

QToolTip {
    background-color: #172B35;
    color: #FFFFFF;
    border: 1px solid #304A56;
    padding: 6px 8px;
}
