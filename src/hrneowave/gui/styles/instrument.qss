/* CHNeoWave — scientific workstation interface, rebuilt from first principles. */

QMainWindow, QDialog, QWidget {
    background: @BG@;
    color: @TEXT@;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 12px;
}
QWidget#mainContent, QWidget#contentCanvas, QScrollArea#pageScroll,
QScrollArea#pageScroll > QWidget > QWidget { background: @BG@; }
QToolTip {
    background: @TOOLTIP@;
    color: @TEXT_STRONG@;
    border: 1px solid @BORDER_STRONG@;
    padding: 5px 7px;
}

/* Desktop menu */
QMenuBar#desktopMenuBar {
    background: #0B151B;
    color: #B9C7CD;
    border: none;
    border-bottom: 1px solid #24343C;
    padding: 1px 8px;
    min-height: 22px;
}
QMenuBar#desktopMenuBar::item { padding: 4px 10px; background: transparent; }
QMenuBar#desktopMenuBar::item:selected { background: #22333C; color: #FFFFFF; }
QMenu {
    background: @PANEL@;
    color: @TEXT@;
    border: 1px solid @BORDER_STRONG@;
    padding: 5px;
}
QMenu::item { min-width: 220px; padding: 7px 24px 7px 10px; }
QMenu::item:selected { background: @ACCENT_SOFT@; color: @TEXT_STRONG@; }
QMenu::separator { height: 1px; background: @BORDER@; margin: 4px 6px; }

/* Horizontal application shell */
QFrame#topNavigation {
    background: #101D24;
    border: none;
    border-bottom: 1px solid #30434C;
}
QFrame#horizontalBrand { background: transparent; border: none; }
QLabel#horizontalBrandMark { background: transparent; }
QLabel#horizontalBrandCopy {
    background: transparent;
    color: #F1F5F6;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.25;
}
QPushButton#workspaceNavButton {
    background: transparent;
    color: #A6B7BE;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 0;
    padding: 0 10px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#workspaceNavButton:hover { background: #1B2C34; color: #FFFFFF; }
QPushButton#workspaceNavButton[active="true"] {
    background: #172B35;
    color: #FFFFFF;
    border-bottom-color: #23A8C3;
}
QLabel#navigationContext, QLabel#navigationHardware {
    background: transparent;
    color: #90A5AE;
    border-left: 1px solid #2A3A42;
    min-width: 94px;
    max-width: 142px;
    padding: 0 10px;
    font-size: 9px;
    font-weight: 600;
}
QLabel#navigationHardware { color: #D39A43; }
QLabel#navigationHardware[connected="true"] { color: #55C59B; }
QPushButton#navigationTheme {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 0;
}
QPushButton#navigationTheme:hover { background: #22343D; border-color: #3B5059; }

/* Analysis command surface */
QWidget#analysisWorkspace { background: @BG@; }
QFrame#sourceChannelBar {
    background: @PANEL@;
    border: none;
    border-bottom: 1px solid @BORDER_STRONG@;
}
QLabel#commandCaption {
    color: @MUTED@;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: .4px;
}
QLabel#commandHint { color: @MUTED@; font-size: 10px; }
QLabel#sourceMeta, QLabel#channelVisibleCount {
    color: @MUTED@;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 10px;
}
QComboBox#sourceCombo { min-height: 28px; }
QPushButton#commandButton, QPushButton#channelCommand {
    min-height: 27px;
    max-height: 27px;
    padding: 0 9px;
}
QPushButton#channelCommand { background: transparent; border-color: transparent; color: @ACCENT@; }
QPushButton#channelCommand:hover { background: @HOVER@; border-color: @BORDER@; }
QListView#channelRibbon {
    background: @PANEL_ALT@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 2px;
    outline: none;
    padding: 1px;
}
QListView#channelRibbon::item { border-right: 1px solid @BORDER@; }
QSplitter#analysisHorizontalSplitter::handle { background: @BORDER_STRONG@; width: 3px; }

/* Scientific results workbench */
QFrame#analysisWorkbench { background: @CANVAS@; border: none; }
QFrame#workbenchStatus, QFrame#plotHeader {
    background: @HEADER@;
    border: none;
    border-bottom: 1px solid @BORDER@;
    min-height: 33px;
    max-height: 33px;
}
QLabel#plotTitle, QLabel#paneTitle {
    color: @TEXT_STRONG@;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: .35px;
}
QLabel#plotMeta { color: @MUTED@; font-size: 10px; }
QLabel#analysisState { color: @ACCENT@; font-size: 10px; font-weight: 750; }
QSplitter#plotSplitter::handle { background: @BORDER_STRONG@; height: 3px; }
QFrame#scientificPlot { background: @CANVAS@; border: none; }
QWidget#plotCanvas { border: none; }
QPushButton#plotTool, QPushButton#iconTool {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px;
}
QPushButton#plotTool:hover, QPushButton#iconTool:hover { background: @HOVER@; border-color: @BORDER@; }
QPushButton#plotTool:checked { background: @ACCENT_SOFT@; border-color: @ACCENT@; }

/* Analysis parameters — single inspector, no nested cards */
QFrame#scientificInspector { background: @PANEL@; border: none; border-left: 1px solid @BORDER_STRONG@; }
QFrame#paneHeader { background: @HEADER@; border: none; border-bottom: 1px solid @BORDER@; min-height: 33px; max-height: 33px; }
QScrollArea#inspectorScroll, QScrollArea#inspectorScroll > QWidget > QWidget { background: @PANEL@; border: none; }
QFrame#inspectorSection { background: @PANEL@; border: none; border-bottom: 1px solid @BORDER@; }
QLabel#inspectorSectionTitle { color: @MUTED@; font-size: 10px; font-weight: 750; }
QLabel#technicalValue { color: @TEXT_STRONG@; font-family: "Cascadia Mono", "Consolas", monospace; font-size: 11px; }
QFrame#inspectorActions { background: @PANEL_ALT@; border: none; border-top: 1px solid @BORDER_STRONG@; }
QPushButton#runAnalysis {
    min-height: 34px;
    max-height: 34px;
    background: @ACCENT@;
    color: @ACCENT_TEXT@;
    border: 1px solid @ACCENT@;
    border-radius: 2px;
    font-weight: 750;
}
QPushButton#runAnalysis:hover { background: @ACCENT_HOVER@; }

/* Numerical readouts */
QFrame#metricStrip { background: @TOPBAR@; border: none; border-top: 1px solid @BORDER_STRONG@; min-height: 68px; max-height: 68px; }
QFrame#resultReadout { background: transparent; border: none; border-right: 1px solid @BORDER@; border-radius: 0; }
QFrame#resultReadout[state="warning"] { border-top: 2px solid @WARNING@; }
QFrame#resultReadout[state="danger"] { border-top: 2px solid @DANGER@; }
QFrame#resultReadout[state="success"] { border-top: 2px solid @SUCCESS@; }
QFrame#settingsReadout { background: @PANEL_ALT@; border: 1px solid @BORDER@; border-top: 2px solid @ACCENT@; }
QFrame#settingsReadout[status="warning"] { border-top-color: @WARNING@; }
QFrame#settingsReadout[status="critical"], QFrame#settingsReadout[status="error"] { border-top-color: @DANGER@; }
QFrame#settingsReadout[status="success"] { border-top-color: @SUCCESS@; }
QLabel#readoutCaption { color: @MUTED@; font-size: 9px; font-weight: 750; }
QLabel#readoutValue { color: @TEXT_STRONG@; font-family: "Cascadia Mono", "Consolas", monospace; font-size: 16px; font-weight: 650; }
QLabel#readoutUnit, QLabel#readoutDetail { color: @MUTED@; font-size: 9px; }
QFrame#detailsDrawer { background: @PANEL@; border: none; border-top: 1px solid @BORDER_STRONG@; }
QFrame#detailsModes { background: @HEADER@; border: none; border-bottom: 1px solid @BORDER@; }
QPushButton#drawerMode {
    background: transparent;
    color: @MUTED@;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    min-height: 27px;
    padding: 0 12px;
    font-size: 10px;
    font-weight: 650;
}
QPushButton#drawerMode:checked { color: @TEXT_STRONG@; border-bottom-color: @ACCENT@; }
QComboBox#engineerDecision { min-width: 132px; }

/* Acquisition and report surfaces */
QFrame#acquisitionModeBar { background: @HEADER@; border: 1px solid @BORDER@; border-bottom: none; }
QPushButton#acquisitionMode {
    background: transparent; color: @MUTED@; border: none; border-bottom: 2px solid transparent;
    border-radius: 0; min-height: 31px; padding: 0 14px; font-size: 10px; font-weight: 700;
}
QPushButton#acquisitionMode:hover { color: @TEXT_STRONG@; background: @HOVER@; }
QPushButton#acquisitionMode:checked { color: @TEXT_STRONG@; border-bottom-color: @ACCENT@; background: @PANEL@; }
QFrame#acquisitionConfigActions { background: @PANEL_ALT@; border: 1px solid @BORDER@; border-top: none; }
QFrame#reportEvidence { background: @PANEL_ALT@; border: 1px solid @BORDER@; border-left: 3px solid @ACCENT@; }
QTextEdit#reportDocument { background: #FFFFFF; color: #182D36; border: 1px solid @BORDER_STRONG@; padding: 14px; }
QFrame#settingsSection { background: @PANEL@; border: 1px solid @BORDER@; border-radius: 2px; }
QFrame#settingsSectionHeader { background: @HEADER@; border: none; border-bottom: 1px solid @BORDER@; }
QWidget#settingsSectionContent { background: @PANEL@; }

/* Native controls */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background: @INPUT@;
    color: @TEXT@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 2px;
    min-height: 28px;
    padding: 0 7px;
    selection-background-color: @ACCENT@;
}
QTextEdit, QPlainTextEdit { padding: 6px; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus { border-color: @ACCENT@; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { background: @DISABLED@; color: @MUTED@; }
QComboBox::drop-down { width: 20px; border-left: 1px solid @BORDER@; }
QComboBox QAbstractItemView { background: @INPUT@; color: @TEXT@; border: 1px solid @BORDER_STRONG@; selection-background-color: @ACCENT_SOFT@; }
QCheckBox { color: @TEXT@; spacing: 6px; min-height: 22px; }
QCheckBox::indicator { width: 13px; height: 13px; border: 1px solid @BORDER_STRONG@; border-radius: 1px; background: @INPUT@; }
QCheckBox::indicator:checked { background: @ACCENT@; border-color: @ACCENT@; }
QPushButton {
    background: @BUTTON@;
    color: @TEXT@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 2px;
    min-height: 29px;
    padding: 0 11px;
    font-weight: 550;
}
QPushButton:hover { background: @HOVER@; border-color: @ACCENT@; }
QPushButton:pressed { background: @ACCENT_SOFT@; }
QPushButton[kind="primary"], QPushButton[kind="primaryLarge"] { background: @ACCENT@; color: @ACCENT_TEXT@; border-color: @ACCENT@; }
QPushButton[kind="quiet"] { background: transparent; border-color: transparent; }

/* Shared legacy view object names receive one coherent material system. */
QFrame#surface, QFrame#projectForm, QFrame#contextPanel, QFrame#metricCard,
QFrame#workflowCard, QFrame#analysis_tools_panel, QFrame#analysis_results_area,
QFrame#report_config_panel, QFrame#report_preview_area, QFrame#operationalHeader,
QFrame#quietSurface, QFrame#contextBar, QGroupBox {
    background: @PANEL@;
    border: 1px solid @BORDER@;
    border-radius: 2px;
}
QLabel#viewTitle { color: @TEXT_STRONG@; font-size: 18px; font-weight: 650; }
QLabel#sectionTitle { color: @TEXT_STRONG@; font-size: 13px; font-weight: 650; }
QLabel#metricLabel, QLabel#mutedText, QLabel[role="muted"], QLabel#pageSubtitle { color: @MUTED@; font-size: 11px; }
QLabel#metricValue { color: @TEXT_STRONG@; font-family: "Cascadia Mono", "Consolas", monospace; font-size: 15px; font-weight: 650; }
QTabWidget::pane { background: @PANEL@; border: 1px solid @BORDER@; }
QTabBar::tab { background: @HEADER@; color: @MUTED@; border: none; border-bottom: 2px solid transparent; padding: 7px 12px; }
QTabBar::tab:selected { color: @TEXT_STRONG@; border-bottom-color: @ACCENT@; }
QTableWidget, QTableView {
    background: @PANEL@;
    alternate-background-color: @PANEL_ALT@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    gridline-color: @BORDER@;
    selection-background-color: @ACCENT_SOFT@;
}
QHeaderView::section {
    background: @HEADER@;
    color: @TEXT_STRONG@;
    border: none;
    border-right: 1px solid @BORDER@;
    border-bottom: 1px solid @BORDER_STRONG@;
    padding: 6px;
    font-size: 10px;
    font-weight: 650;
}
QScrollBar:vertical { background: @PANEL@; width: 9px; margin: 0; }
QScrollBar::handle:vertical { background: @BORDER_STRONG@; min-height: 28px; border-radius: 3px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: @PANEL@; height: 9px; margin: 0; }
QScrollBar::handle:horizontal { background: @BORDER_STRONG@; min-width: 28px; border-radius: 3px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QStatusBar { background: @TOPBAR@; color: @MUTED@; border-top: 1px solid @BORDER@; }
